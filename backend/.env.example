# =============================================================================
# .env.example - Variáveis de Ambiente do Backend
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no repositório!
# =============================================================================

# ===========================================================================
# Banco de Dados (PostgreSQL)
# ===========================================================================
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# No Render: use a connection string gerada automaticamente pelo serviço de DB
DATABASE_URL=postgresql://neuroeval_user:SENHA_AQUI@localhost:5432/neuroeval

# ===========================================================================
# Autenticação JWT
# ===========================================================================
# Gere uma chave segura: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERAR_CHAVE_SEGURA_64_BYTES_HEX_AQUI
JWT_EXPIRES_IN=24h

# ===========================================================================
# Criptografia AES-256 (mínimo 32 caracteres)
# ===========================================================================
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=GERAR_CHAVE_SEGURA_32_BYTES_BASE64_AQUI

# ===========================================================================
# CORS / Frontend
# ===========================================================================
# URL do frontend em produção (ex: https://neuroeval-frontend.onrender.com)
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ===========================================================================
# Servidor
# ===========================================================================
NODE_ENV=development
PORT=3000
