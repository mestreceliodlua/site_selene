{
  "name": "neuroeval",
  "version": "2.0.0",
  "description": "Sistema de Avaliação Neuropsicológica - NeuroEval",
  "main": "script.js",
  "scripts": {
    "build": "echo 'Projeto estático - sem build necessário'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom='script.js'",
    "test:e2e": "cypress open",
    "test:e2e:ci": "cypress run",
    "start": "next start",
    "dev": "npx http-server -p 5500",
    "lint": "eslint *.js",
    "format": "prettier --write *.js *.css *.html"
  },
  "keywords": [
    "neuropsychology",
    "evaluation",
    "healthcare",
    "lgpd",
    "accessibility"
  ],
  "author": "NeuroEval Team",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.1.5",
    "cypress": "^13.6.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "script.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}